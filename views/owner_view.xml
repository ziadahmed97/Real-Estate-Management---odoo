<odoo>
    <record id="owner_view_tree" model="ir.ui.view">
        <field name="name">owner tree</field>
        <field name="model">owner</field>
        <field name="arch" type="xml">
            <list multi_edit="True" create="1" edit="1" delete="1">
                <field name="name"/>
                <field name="phone"/>
                <field name="address"/>
                <field name="property_ids"/>
            </list>
        </field>

    </record>

    <record id="owner_view_form" model="ir.ui.view">
        <field name="name">owner form</field>
        <field name="model">owner</field>
        <field name="arch" type="xml">
            <form  create="1" edit="1" delete="1">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <field name="phone"/>
                        <field name="address"/>
                        <field name="property_ids" widget="many2many_tags"/>
                    </group>
                </sheet>
            </form>
        </field>

    </record>
<!--    <record id="property_view_search" model="ir.ui.view">-->
<!--        <field name="name">property search</field>-->
<!--        <field name="model">property</field>-->
<!--        <field name="arch" type="xml">-->
