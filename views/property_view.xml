<odoo>
    <record id="property_view_tree" model="ir.ui.view">
        <field name="name">property tree</field>
        <field name="model">property</field>
        <field name="arch" type="xml">
            <list multi_edit="True" create="1" edit="1" delete="1" class="header_custom" decoration-danger="(is_late)">
                <header>
                    <button name="property_xlsx_report" type="object" string="print EXCEL Report" class="btn-primary"/>
                </header>
                <field name="name"/>
                <field name="description"/>
                <field name="postcode"/>
                <field name="owner_id"/>
                <field name="owner_phone"/>
                <field name="owner_address"/>
                <field name="date_availability"/>
                <field name="date_time"/>
                <field name="is_late" invisible="1"/>
                <field name="expected_price"/>
                <field name="selling_price"/>
                <field name="diff"/>
                <field name="bedrooms" optional="1"/>
                <field name="state"/>
                <field name="garage" optional="1"/>
                <field name="garden_orientation"/>
                <field name="tag_ids" widget="many2many_tags"/>
                <field name="active"/>
            </list>
        </field>

    </record>

    <record id="property_view_form" model="ir.ui.view">
        <field name="name">property form</field>
        <field name="model">property</field>
        <field name="arch" type="xml">
            <form  create="1" edit="1" delete="1">
                <sheet>
                    <div name="button_box" class="oe_button_box">
                        <button name="action_open_related_owner" type="object" string="Owner" icon="fa-user" invisible="not owner_id"/>
                    </div>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <widget name="web_ribbon" title="Sold" bg_color="text-bg-success" invisible="state != 'sold'"/>
                    <header>
                        <button name="action" type="object" class="btn-primary" string="action"/>
                        <button name="get_properties" type="object" class="btn-primary" string="get properties"/>
                        <button name="action_draft" type="object" class="btn-primary" string="set to draft" invisible="state in ('draft','closed') "/>
                        <button name="action_pending" type="object" class="btn-primary" string="set to pending " invisible="state != 'draft'"/>
                        <button name="action_sold" type="object" class="btn-primary" string="set to sold" invisible="state != 'pending'"/>
                         <field name="state" widget="statusbar" options="{'clickable':0}"/>
<!--                        statusbar_visible="draft,sold"-->
                    </header>
                    <div class="oe_title">
                        <label for="ref"/>
                        <h1>
                            <field name="ref"/>
                        </h1>
                        <label for="name"/>
                        <h4>
                            <field name="name" />
                        </h4>
                    </div>
                    <group>
                        <group string="General info">

                            <field name="postcode"/>
                            <field name="description" required="1" groups = "AppOne.property_manager_group"/>
                            <field name="date_availability" required="1" />
                            <field name="expected_selling_date" readonly="state == 'closed'"/>
                            <field name="is_late" invisible="1" readonly="state == 'closed'"/>
                            <field name="date_time"/>
                            <field name="create_time" readonly="1"/>
                            <field name="next_time" readonly="1"/>

                        </group>
                        <group string="additional info" >
                            <field name="owner_id" readonly="state == 'closed'"/>
                            <field name="owner_phone" readonly="state == 'closed'"/>
                            <field name="owner_address" readonly="state == 'closed'"/>
                            <field name="expected_price" readonly="state == 'closed'"/>
                            <field name="selling_price" readonly="state == 'closed'"/>
                            <field name="diff" readonly="state == 'closed'"/>
                            <field name="bedrooms" />
                            <field name="garage" readonly="state == 'closed'"/>
                            <field name="garden_orientation"/>
                            <field name="tag_ids" readonly="state == 'closed'"/>
                            <field name="active" readonly="state == 'closed'"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="bedrooms">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="description"/>
                                    <field name="area"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter class="oe_chatter">
                     <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </chatter>
            </form>
        </field>

    </record>
