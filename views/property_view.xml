        <record id="property_change_state_server_action" model="ir.actions.server">
        <field name="name">change state</field>
        <field name="model_id" ref="model_property"/>
        <field name="binding_model_id" ref="model_property"/>
        <field name="state">code</field>
        <field name="code">
            action= records.action_open_change_state_wizard()
        </field>
    </record>
    <record id="selling_date_action" model="ir.cron">
        <field name="name">property: check selling date</field>
        <field name="model_id" ref="model_property"/>
        <field name="state">code</field>
        <field name="code">model.check_expected_selling_date()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active">True</field>
    </record>
    <menuitem
         id="property_ment_item"
         name = "Properties"
         parent="properties_root_menu"
         action = "property_action"
    />
    <record id="action_list_view" model="ir.actions.client">
    <field name="name">List View</field>
    <field name="tag">AppOne.action_list_view</field>
    </record>
    <menuitem
         id="property_list_view_ment_item"
         name = "Properties OWL"
         parent="properties_root_menu"
         action = "action_list_view"
    />
